# Environment variables read by ram_tracker/settings.py.
# The project has NO python-dotenv dependency: every value has a development default,
# so you only need to set these if your setup differs. Set them in your shell, e.g.
#   Windows PowerShell:  $env:MONGODB_URI = "mongodb://localhost:27017"
#   macOS / Linux:       export MONGODB_URI="mongodb://localhost:27017"

# MongoDB connection string (local server, or a MongoDB Atlas "mongodb+srv://..." string)
MONGODB_URI=mongodb://localhost:27017
# Database name used by the application
MONGODB_NAME=ram_price_tracker
# Change this for anything other than local development
DJANGO_SECRET_KEY=change-me
# 1 (default) for development, 0 for production-like runs
DJANGO_DEBUG=1
# Comma-separated host names, only needed when DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
